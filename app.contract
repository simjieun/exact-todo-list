routes nav
  home "/"

shape Time
  epochAtZero: number
  utcOffset: number
shape Item
  id: string
  title: string
  done: bool
shape Day
  items: Item[]
  total: number
  done: number
  previous: string
  next: string
shape Reply
  ok: bool
  error: string

component App
  resource time = exactTime() as shape Time
  state now = 0
  state selected = ""
  state draft = ""
  state filter = "all"
  state editId = ""
  state editTitle = ""
  state deleteId = ""
  state actionsId = ""
  derive today = formatDate(time.epochAtZero + now, time.utcOffset, "iso")
  derive day = selected == "" ? today : selected
  derive percent = log.total == 0 ? 0 : round(log.done * 100 / log.total)
  resource log = loadDay(day) as shape Day else empty()
  mutation added as shape Reply refreshes log then afterAdd
  mutation changed as shape Reply queue refreshes log
  mutation renamed as shape Reply refreshes log then afterRename
  derive busy = pending(added) or pending(changed) or pending(renamed)
  derive visible = log.items.filter(i => filter == "all" or (filter == "open" and not i.done) or (filter == "done" and i.done))
  derive addError = match added { case some(r) => r.error, case none => "" }
  derive changeError = match changed { case some(r) => r.error, case none => "" }
  derive renameError = match renamed { case some(r) => r.error, case none => "" }
  task tick mount
    every(60000, step)
  action step
    now = performanceNow()
  action choose(v: string)
    if v != ""
      selected = v
  action goToday
    now = performanceNow()
    selected = ""
  action edit(v: string)
    draft = v
  action add
    if draft.trim() != "" and not busy
      let at = time.epochAtZero + performanceNow()
      now = performanceNow()
      send added = addTask(selected == "" ? formatDate(at, time.utcOffset, "iso") : selected, draft)
  action afterAdd
    if addError == ""
      draft = ""
  action toggle(id: string, done: bool)
    send changed = setDone(id, done)
  action setFilter(v: string)
    filter = v
  action showActions(id: string)
    actionsId = actionsId == id ? "" : id
  action startEdit(id: string, title: string)
    editId = id
    editTitle = title
    renamed = none
    showModal("editor")
  action editName(v: string)
    editTitle = v
  action rename
    send renamed = renameTask(editId, editTitle)
  action afterRename
    if renameError == ""
      close("editor")
  action askDelete(id: string)
    deleteId = id
    showModal("delete-confirm")
  action remove
    send changed = deleteTask(deleteId)
    close("delete-confirm")
  action retry
    refresh log
  action follow(url: string)
    nav = go(nav, url)
  view
    main testId="root" navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%" background-color="surface.page" color="text.primary"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0 background-color="surface.page"
            scroll id="content" flex=1 min-height=0
              column width="100%" max-width="40rem" margin-left="auto" margin-right="auto" padding="12px 20px 48px" gap=16 box-sizing="border-box"
                row gap=10 align-items="center" padding="8px 0"
                  row width="1.875rem" height="1.875rem" border-radius=9 background-color="brand.fill" color="ink.on-brand" align-items="center" justify-content="center"
                    image "symbol:checkmark" aria-label="" font-size="0.9375rem" font-weight=700
                  text "하루 한 걸음" font-size="1rem" font-weight=700 flex=1
                  button press=goToday background-color="surface.card" color="text.primary" border-radius=12 padding="8px 14px" font-weight=600 testId="today"
                    text "오늘"
                text (day == today ? "오늘 할 일" : "이날의 할 일") role="heading" aria-level=1 font-size="1.75rem" font-weight=700 margin-top=8
                row gap=8 align-items="center"
                  button press=choose(log.previous) disabled=(not current(log) or busy) background-color="surface.card" border-radius=12 padding="10px 14px" aria-label="이전 날짜" testId="previous"
                    text "‹ 이전"
                  input type="date" value=day input=choose aria-label="날짜 선택" flex=1 min-width=0 background-color="surface.card" color="text.primary" border-radius=12 padding="10px 12px" border="none" testId="date"
                  button press=choose(log.next) disabled=(not current(log) or busy) background-color="surface.card" border-radius=12 padding="10px 14px" aria-label="다음 날짜" testId="next"
                    text "다음 ›"
                text day color="text.secondary" font-size="0.875rem" testId="day"
                column background-color="surface.soft" border-radius=24 padding=24 gap=8
                  text "하루의 작은 성취" color="text.accent" font-size="0.9375rem" font-weight=600
                  text (log.done == 0 ? "작은 시작이면 충분해요" : `${log.done}개나 해냈어요`) font-size="1.625rem" font-weight=700
                  text (log.total == 0 ? "작은 할 일 하나부터 시작해 볼까요?" : `완료 ${log.done}개 · 남은 할 일 ${log.total - log.done}개`) color="text.secondary" font-size="0.9375rem"
                  row height=8 margin-top=8 border-radius=4 background-color="surface.card" overflow="hidden" aria-label=`진행률 ${percent}%`
                    box width=`${percent}%` background-color="brand.fill" border-radius=4
                column background-color="surface.card" border-radius=24 padding=20 gap=12
                  row gap=8 align-items="center"
                    input value=draft input=edit submit=add placeholder="오늘 할 일을 적어보세요" aria-label="새 할 일" disabled=pending(added) flex=1 min-width=0 background-color="surface.fill" color="text.primary" border="none" border-radius=14 padding="14px 16px" font-size="1rem" testId="draft"
                    button press=add disabled=(draft.trim() == "" or busy or not current(log)) background-color="brand.fill" color="ink.on-brand" border-radius=14 padding="14px 20px" font-weight=600 testId="add"
                      text "추가"
                  if addError != "" and not pending(added)
                    text addError color="text.danger" font-size="0.875rem" testId="add-error"
                  if failed(added) or failed(changed) or failed(renamed)
                    text "저장하지 못했어요. 입력을 확인하고 다시 시도해 주세요." color="text.danger" font-size="0.875rem"
                row gap=4 padding=4 background-color="surface.track" border-radius=14
                  button press=setFilter("all") aria-pressed=(filter == "all" ? "true" : "false") flex=1 border-radius=10 padding="10px 0" font-weight=600 background-color=(filter == "all" ? "surface.card" : "surface.track") color=(filter == "all" ? "text.primary" : "text.secondary") testId="filter-all"
                    text "전체"
                  button press=setFilter("open") aria-pressed=(filter == "open" ? "true" : "false") flex=1 border-radius=10 padding="10px 0" font-weight=600 background-color=(filter == "open" ? "surface.card" : "surface.track") color=(filter == "open" ? "text.primary" : "text.secondary") testId="filter-open"
                    text "진행 중"
                  button press=setFilter("done") aria-pressed=(filter == "done" ? "true" : "false") flex=1 border-radius=10 padding="10px 0" font-weight=600 background-color=(filter == "done" ? "surface.card" : "surface.track") color=(filter == "done" ? "text.primary" : "text.secondary") testId="filter-done"
                    text "완료"
                column background-color="surface.card" border-radius=24 padding="20px 20px 12px" gap=4
                  text "할 일" role="heading" aria-level=2 font-size="1.0625rem" font-weight=700 margin-bottom=4
                  if failed(log)
                    column gap=8 padding="12px 0"
                      text "기록을 불러오지 못했어요." testId="load-error"
                      button press=retry background-color="surface.fill" border-radius=12 padding="10px 14px" testId="retry"
                        text "다시 불러오기"
                  else if not current(log)
                    text "기록을 불러오는 중…" color="text.secondary" padding="12px 0"
                  else
                    for i in visible key=i.id
                      column gap=8 padding="10px 0"
                        row gap=12 align-items="center"
                          input type="checkbox" checked=i.done change=toggle(i.id) disabled=busy aria-label=i.title width=24 height=24 testId=`done-${i.id}`
                          text i.title flex=1 min-width=0 font-size="1rem" color=(i.done ? "text.secondary" : "text.primary") text-decoration=(i.done ? "line-through" : "none") testId=`title-${i.id}`
                          button press=showActions(i.id) aria-expanded=(actionsId == i.id) aria-label=`${i.title} 더보기` color="text.secondary" border-radius=12 padding="6px 10px" font-size="1.125rem" testId=`more-${i.id}`
                            text "⋯"
                        if actionsId == i.id
                          row gap=8 padding-left=36
                            button press=startEdit(i.id, i.title) disabled=busy background-color="surface.fill" border-radius=10 padding="8px 14px" font-size="0.875rem" aria-label=`수정: ${i.title}` testId=`edit-${i.id}`
                              text "수정"
                            button press=askDelete(i.id) disabled=busy background-color="surface.fill" color="text.danger" border-radius=10 padding="8px 14px" font-size="0.875rem" aria-label=`삭제: ${i.title}` testId=`delete-${i.id}`
                              text "삭제"
                    if visible.length == 0
                      text (log.total == 0 ? "아직 할 일이 없어요. 위에서 첫 할 일을 추가해 주세요." : "이 조건에 맞는 할 일이 없어요.") color="text.secondary" padding="24px 0" testId="empty"
                  if changeError != "" and not pending(changed)
                    text changeError color="text.danger" font-size="0.875rem" testId="change-error"
                column gap=4 padding="0 4px"
                  text `남은 할 일 ${log.total - log.done}개` font-weight=600 testId="remaining"
                  text "이 기기에 자동 저장됩니다. 기기 간 동기화는 지원하지 않아요." font-size="0.8125rem" color="text.secondary"
      dialog id="editor" aria-label="할 일 수정" background-color="surface.card" color="text.primary" border="none" border-radius=24 padding=24
        column gap=16
          text "할 일 수정" role="heading" font-size="1.25rem" font-weight=700
          input value=editTitle input=editName submit=rename disabled=pending(renamed) aria-label="수정할 내용" background-color="surface.fill" color="text.primary" border="none" border-radius=14 padding="14px 16px" testId="edit-title"
          if renameError != "" and not pending(renamed)
            text renameError color="text.danger" font-size="0.875rem" testId="rename-error"
          row gap=8
            button commandfor="editor" command="close" disabled=pending(renamed) flex=1 background-color="surface.fill" border-radius=14 padding="14px 0" font-weight=600 testId="edit-cancel"
              text "취소"
            button press=rename disabled=(editTitle.trim() == "" or pending(renamed)) flex=1 background-color="brand.fill" color="ink.on-brand" border-radius=14 padding="14px 0" font-weight=600 testId="edit-save"
              text "저장"
      dialog id="delete-confirm" role="alertdialog" aria-label="할 일을 삭제할까요?"
        text "삭제한 할 일은 복구할 수 없어요."
        button commandfor="delete-confirm" command="close" testId="delete-cancel"
          text "취소"
        button press=remove commandfor="delete-confirm" command="close" destructive=true testId="delete-confirm-button"
          text "삭제"
